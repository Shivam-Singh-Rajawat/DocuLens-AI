# Normal RAG mode: local sentence embeddings + persistent Chroma + optional CrossEncoder.
DATA_DIR=./data
# Metadata: sqlite (default) or postgres (requires local DATABASE_URL)
METADATA_BACKEND=sqlite
DATABASE_URL=
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_BACKEND=chroma
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM_PROVIDER=gemini (requires key) | ollama (locally running) | none (evidence-only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.22
MAX_UPLOAD_MB=20
ENABLE_OCR=false

# Set a long random token before exposing the service beyond localhost.
APP_ACCESS_TOKEN=
