# Diagnostic offline mode — vector embeddings are word-hashed, NOT semantic.
# Use .env.example and install full requirements for real RAG quality.
DATA_DIR=./data
EMBEDDING_BACKEND=hash
VECTOR_BACKEND=sqlite
ENABLE_RERANKER=false
LLM_PROVIDER=none
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.22
MAX_UPLOAD_MB=20
ENABLE_OCR=false
APP_ACCESS_TOKEN=
